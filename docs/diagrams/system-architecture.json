  "cards": [
    {
      "dot": "cyan",
      "title": "分層職責",
      "items": [
        "前端只呼叫 /api/*，不直接碰 SCPI",
        "JobManager 掌管非同步進度、暫停與取消",
        "Workflow 對 InstrumentSession Protocol 撰寫，實機與 Mock 可互換"
      ]
    },
    {
      "dot": "rose",
      "title": "RF 安全邊界",
      "items": [
        "validate_safety 檢查操作員確認、port 與功率上限",
        "capabilities 只放行已 HIL 驗證的 band／bandwidth 區段",
        "成功、錯誤、逾時與取消都會 STOP／ABORT 並 RF Off"
      ]
    },
    {
      "dot": "emerald",
      "title": "可稽核證據",
      "items": [
        "SCPI 指令集中於 configs/scpi_command_map.yaml",
        "每次 Run 輸出 CSV、JSON、metadata 與 report.html",
        "歷史分析只讀既有 artifacts，不送 RF"
        ,"Constellation Mock 不進 RF 授權區，hardware adapter 維持 HIL_PENDING"
      ]
    }
  ]
